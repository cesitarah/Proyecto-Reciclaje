generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Rol {
  id_rol    Int       @id @default(autoincrement())
  nombre    String    @db.VarChar(50)

  usuarios  Usuario[]
}

model Usuario {
  id_usuario Int         @id @default(autoincrement())
  nombre     String      @db.VarChar(100)
  correo     String      @unique @db.VarChar(150)
  contrasena String      @db.VarChar(255)
  telefono   String?     @db.VarChar(20)
  id_rol     Int

  rol         Rol         @relation(fields: [id_rol], references: [id_rol])
  ofertas     Oferta[]
  solicitudes Solicitud[]
  mensajes    Mensaje[]
}

model Material {
  id_material   Int      @id @default(autoincrement())
  nombre        String   @db.VarChar(100)
  descripcion   String?  @db.VarChar(255)
  precio_por_kg Decimal  @db.Decimal(10, 2)
  estado        String   @db.VarChar(30)

  ofertas       Oferta[]
}

model Oferta {
  id_oferta            Int      @id @default(autoincrement())
  id_vendedor          Int
  id_material          Int
  cantidad_disponible  Decimal  @db.Decimal(10, 2)
  ubicacion             String   @db.VarChar(150)
  fecha_publicacion     DateTime @default(now())
  estado                String   @db.VarChar(30)

  vendedor  Usuario   @relation(fields: [id_vendedor], references: [id_usuario])
  material  Material  @relation(fields: [id_material], references: [id_material])
  solicitudes Solicitud[]
}

model Solicitud {
  id_solicitud       Int      @id @default(autoincrement())
  id_oferta          Int
  id_comprador       Int
  cantidad_solicitada Decimal @db.Decimal(10, 2)
  estado              String  @db.VarChar(30)
  fecha_solicitud     DateTime @default(now())

  oferta      Oferta    @relation(fields: [id_oferta], references: [id_oferta])
  comprador   Usuario   @relation(fields: [id_comprador], references: [id_usuario])
  mensajes    Mensaje[]
}

model Mensaje {
  id_mensaje    Int      @id @default(autoincrement())
  id_solicitud Int
  id_usuario   Int
  mensaje      String
  tipo         String?  @db.VarChar(50)
  fecha        DateTime @default(now())

  solicitud Solicitud @relation(fields: [id_solicitud], references: [id_solicitud])
  usuario   Usuario   @relation(fields: [id_usuario], references: [id_usuario])
}